<mxfile host="app.diagrams.net"><diagram id="tp2" name="PKI labo TP2"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;ALPINA SERVICES : PKI de laboratoire AD CS (TP2)&lt;/b&gt;" style="text;html=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="700" height="30" as="geometry"/></mxCell><mxCell id="z1" value="Réseau isolé VMnet1 (host-only) 192.168.178.0/24 · domaine pki.lab" style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1100" height="660" as="geometry"/></mxCell><mxCell id="z2" value="OU=Postes-Lab · GPO-PKI-AutoEnroll-Postes" style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;dashed=1;verticalAlign=bottom;align=right;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="45" y="520" width="685" height="155" as="geometry"/></mxCell><mxCell id="dc" value="&lt;b&gt;SRV-DC01&lt;/b&gt;&lt;br&gt;192.168.178.10&lt;br&gt;AD DS + DNS (zone pki.lab)&lt;br&gt;&lt;i&gt;Modèles, GPO, CDP/AIA (LDAP)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="300" height="120" as="geometry"/></mxCell><mxCell id="ca" value="&lt;b&gt;SRV-CA01&lt;/b&gt;&lt;br&gt;192.168.178.11&lt;br&gt;ALPINA-LAB-CA&lt;br&gt;&lt;i&gt;Enterprise Root CA, RSA 3072&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="300" width="270" height="120" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;CLIENT01&lt;/b&gt;&lt;br&gt;192.168.178.21&lt;br&gt;&lt;i&gt;membre ALPINA-PKI-Pilote&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="545" width="300" height="100" as="geometry"/></mxCell><mxCell id="ct" value="&lt;b&gt;CLIENT-TEST&lt;/b&gt;&lt;br&gt;192.168.178.22&lt;br&gt;&lt;i&gt;hors groupe pilote&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="415" y="545" width="300" height="100" as="geometry"/></mxCell><mxCell id="e1" value="(1) DNS, LDAP, Kerberos, heure" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="dc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="150"/></Array></mxGeometry></mxCell><mxCell id="e1b" value="(1) DNS, LDAP, Kerberos" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ct" target="dc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="(2) Lecture des modèles, publication du certificat AC et des CRL (LDAP)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="ca" target="dc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955" y="150"/></Array></mxGeometry></mxCell><mxCell id="e5" value="(5) Vérification de la CRL (LDAP)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c1" target="dc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="190"/></Array></mxGeometry></mxCell><mxCell id="e3" value="(3) Inscription (RPC/DCOM) : certificat émis" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="ca"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="697"/><mxPoint x="1000" y="697"/></Array></mxGeometry></mxCell><mxCell id="e4" value="(4) Refus 0x80094012 (ACL du modèle)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="ct" target="ca"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="595"/></Array></mxGeometry></mxCell><mxCell id="leg" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;(1) Résolution DNS, annuaire LDAP, authentification Kerberos et synchronisation horaire avec le DC&lt;br&gt;(2) La CA lit les modèles dans AD et y publie son certificat (AIA) et ses CRL (CDP)&lt;br&gt;(3) CLIENT01, membre du groupe pilote, obtient un certificat ALPINA-Postes-Lab (manuel ou auto-inscription)&lt;br&gt;(4) CLIENT-TEST, hors groupe pilote, est refusé par l'ACL du modèle (CERTSRV_E_TEMPLATE_DENIED)&lt;br&gt;(5) Le client télécharge la CRL à l'adresse LDAP inscrite dans le certificat (aucune URL HTTP configurée)&lt;br&gt;Trait plein : flux autorisé · Pointillés : vérification ou refus" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#000000;spacing=10;fontSize=11;rounded=1;" vertex="1" parent="1"><mxGeometry x="30" y="725" width="1100" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>